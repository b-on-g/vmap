$bog_vmap_part_cell $mol_view
	code? \
	auto? false
	result_text \
	result_number +NaN
	spent \
	error \
	run? null
	sub /
		<= Code $mol_textarea
			hint \return 2 + 2
			value? <=> code?
		<= Bar $mol_view
			sub /
				<= Run $mol_button_minor
					title \Выполнить
					hint \Выполнить тело функции и отдать результат в порты
					click? <=> run? null
				<= Auto $mol_check
					title \Реактивно
					hint \Выполнять на каждую правку кода, а не по кнопке
					checked? <=> auto?
				<= Spent $mol_view
					sub / <= spent
		<= Result $mol_view
			sub / <= result_text
		<= Error $mol_view
			sub / <= error
