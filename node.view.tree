			<= Handle_ne $bog_vmap_app_pane_handle corner \ne
			<= Handle_sw $bog_vmap_app_pane_handle corner \sw
			<= Handle_se $bog_vmap_app_pane_handle corner \se

$bog_vmap_app_pane_label $mol_view
	lines /string
	sub <= rows /$mol_view
	Row* $mol_view
		sub <= row_cells* /$mol_view
	Cell* $mol_view
		sub /
			<= cell_text* \

$bog_vmap_app_pane_handle $mol_view
	corner \
	attr *
		^
		bog_vmap_app_pane_handle_corner <= corner

$bog_vmap_app_pane_frame $mol_frame
	attr *
		sandbox \allow-scripts
		^
		src null

$bog_vmap_app $mol_view
	doc_src \
	doc_css \
	spots? *
	selected? null
	picked? /string
	doc_js *
	doc_root \
	scene_bundle \
	links? \
	palette_showed? true
	inspect_showed? true
	code_showed? false
	history_showed? false
	history_state? *
	code_whole? false
	code_source? \
	code_js? \
	code_css? \
	root_js? \
	root_css? \
	store $bog_vmap_app_store
	plugins /
		<= Theme $bog_theme_auto
	style *
		--mol_theme_hue <= theme_hue \240deg
	sub <= body /$mol_view
	Head $mol_bar
		sub /
			<= Brand $mol_view
				sub /
					\vmap
			<= Palette_check $mol_check
				title \Полка
				checked? <=> palette_showed?
			<= Inspect_check $mol_check
				title \Свойства
				checked? <=> inspect_showed?
			<= Code_check $mol_check
				title \Код
				hint \Три текста выбранного узла: view.tree, JS и CSS
				checked? <=> code_showed?
			<= History_check $mol_check
				title \Версии
				hint \История документа: шаги этой сессии и снимки в ленде
				checked? <=> history_showed?
			<= Board $mol_button_minor
				title \Артборд
				hint \Положить страницу: прямоугольник ширины макета, вёрстка внутри по дереву
				click? <=> board_add? null
			<= Delete $mol_button_minor
				title \Удалить
				hint <= delete_hint \
				enabled <= selection_showed false
				click? <=> node_delete? null
			<= Publish $bog_vmap_app_publish
				part <= publish_part \
				source <= node_source? \
				js <= node_js \
				css <= root_css
				doc <= doc_src
				classes / <= doc_root
			<= Root_name $mol_string
				hint \Имя корневого класса
				value? <=> root_draft? \
				submit? <=> root_submit? null
				event *
					^
					blur? <=> root_submit? null
			<= Download $mol_button_download
				title <= export_title \
				hint <= export_hint \
				enabled <= export_ready false
				blob <= export_blob $mol_blob
				file_name <= export_file \
			<= Status $mol_view
				sub /
					<= status \
			<= Theme_switch $bog_theme_switch
				theme_auto <= Theme
	Notes $mol_view
		sub <= notes /$mol_view
	Alarm $mol_view
		sub /
			<= error \
	Export_note $mol_view
		sub <= export_rows /$mol_view
	Export_row* $mol_view
		sub / <= export_text* \
	Root_note $mol_view
		sub / <= root_title_note \
	Inside_note $mol_view
		sub / <= inside_note \
	pack_stalled false
	Stall $mol_view
		sub <= stall_content /$mol_view
	Stall_note $mol_view
		sub / <= stall_note \
	Stall_pack $mol_button_minor
		title \Вернуть пак по умолчанию
		hint \Убрать адрес библиотеки из полки и взять пак рядом со страницей редактора
		click? <=> pack_default? null
	Stall_reload $mol_button_minor
		title \Перезагрузить сцену
		hint \Поднять кадр заново. Документ хранится в редакторе и не потеряется
		click? <=> scene_restart? null
	Body $mol_view
		sub <= body_main /$mol_view
	Side $mol_view
		sub /
			<= Scenes $bog_vmap_app_scenes
				store <= store
			<= Shelf $bog_vmap_app_shelf
				links? <=> links?
				pack_link <= pack_link
				land_classes <= lib_classes /$mol_tree2
				class_list <= lib_class_list /string
				place? <=> shelf_place? \
	Aside $mol_view
		sub <= aside_content /$mol_view
	Inspect $bog_vmap_app_inspect
		source? <=> node_source? \
		peers <= node_peers /$mol_tree2
		pack <= pack_link \
		class_title? <=> node_title? \
		title_note <= node_title_note \
	Idle $mol_view
		sub /
			<= idle_note \Выберите узел на холсте, чтобы править его свойства
	Code $bog_vmap_app_code
		klass <= code_klass \
		prop <= code_prop \
		hooks <= code_hooks /string
		whole? <=> code_whole?
		source? <=> code_source?
		node_source? <=> node_source?
		js? <=> code_js?
		css? <=> code_css?
		error <= code_error \
	History $bog_vmap_app_history
		store <= store
		state? <=> history_state?
	Lib $bog_vmap_lib_land_stack
		pack <= pack_link
		lands <= lands /string
	Ghost $mol_view
		style *
			left <= ghost_left \0px
			top <= ghost_top \0px
		sub /
			<= ghost_title \
	Pane $bog_vmap_app_pane
		scene_bundle <= scene_bundle
		pack_uri <= pack_script \
		theme <= scene_theme \
		doc_src <= doc_src
		doc_css <= doc_css
		spots? <=> spots?
		picked? <=> picked?
		doc_js <= doc_js
		doc_root <= doc_root
		libs <= libs /$bog_vmap_bridge_part
		carrying <= carrying false
		wires <= doc_wires /$bog_vmap_lang_link
		part_ports* <= part_ports* /$bog_vmap_app_wire_port
		part_overs* <= part_overs* /string
		link_add? <=> link_add? null
		link_drop? <=> link_drop? null
		containers <= doc_containers /string
		doc_names <= doc_names /string
		axis* <= doc_axis* \
		tree_move? <=> tree_move? null
		carry_drop? <=> carry_drop? null
		files_drop? <=> files_drop? null

$mol_image $mol_view
	dom_name \img
	attr *any
		^
		src <= uri \
		title <= hint
		alt <= title \
		loading <= loading \lazy
		decoding <= decoding \async
		crossOrigin <= cors null
		width <= natural_width 0
		height <= natural_height 0
	event *any
		load? <=> load? null
	minimal_width 16
	minimal_height 16
