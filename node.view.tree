$bog_theme_switch $mol_view
	theme_auto $bog_theme_auto
	sub /
		<= Light $mol_button_minor
			attr *
				^
				bog_theme_switch_active <= light_active false
			hint <= light_hint @ \Светлая
			click?event <=> set_light?event null
			sub /
				<= Light_icon $mol_icon_white_balance_sunny
		<= System $mol_button_minor
			attr *
				^
				bog_theme_switch_active <= system_active false
			hint <= system_hint @ \Как в системе
			click?event <=> set_system?event null
			sub /
				<= System_icon $mol_icon_monitor
		<= Dark $mol_button_minor
			attr *
				^
				bog_theme_switch_active <= dark_active false
			hint <= dark_hint @ \Тёмная
			click?event <=> set_dark?event null
			sub /
				<= Dark_icon $mol_icon_weather_night

$bog_vmap_app_palette_item $mol_button_minor
	current false
	minimal_height 24
	drag_start? null
	attr *
		^
		bog_vmap_app_palette_item_current <= current
	event *
		^
		pointerdown? <=> drag_start?

$mol_scroll $mol_view
	scroll_top? 0
	scroll_left? 0
	attr *
		^
		tabindex <= tabindex -1
	event *
		^
		scroll? <=> event_scroll? null

$bog_vmap_app_palette_port $mol_view
	sign \
	body \
	owner \
	inherited false
	attr *
		^
		bog_vmap_app_palette_port_inherited <= inherited
	sub /
		<= Sign $mol_view sub / <= sign
		<= Body $mol_view sub / <= body
		<= Owner $mol_view sub / <= owner

$bog_vmap_app_palette $mol_view
	pack_link \
	query? \
	selected? \
	compact false
	dragged? \
	drag_x? 0
	drag_y? 0
	land_classes /$mol_tree2
	attr *
		^
		bog_vmap_app_palette_compact <= compact
	sub <= body /$mol_view
	Head $mol_bar
		sub /
			<= Brand $mol_view sub / \Палитра
			<= Query $mol_string
				hint \Поиск по имени
				value? <=> query?
			<= Total $mol_view sub / <= total \
	Body $mol_view
		sub <= body_content /$mol_view
	Classes $mol_scroll
		sub /
			<= Class_list $mol_list
				rows <= class_rows /
	Ports $mol_view
		sub /
			<= Ports_head $mol_view
				sub /
					<= Selected $mol_view sub / <= selected_title \
					<= Chain $mol_view sub / <= chain_title \
			<= Ports_scroll $mol_scroll
				sub /
					<= Port_list $mol_list
						rows <= port_rows /
	Class_row* $bog_vmap_app_palette_item
		title <= class_title* \
		click? <=> class_click*? null
		current <= class_current* false
		drag_start? <=> class_drag*? null
	Port_row* $bog_vmap_app_palette_port
		sign <= port_sign* \
		body <= port_body* \
		owner <= port_owner* \
		inherited <= port_inherited* false
	Lib $bog_vmap_lib
		pack <= pack_link
		classes <= land_classes

$bog_vmap_app_scenes $mol_view
	store $bog_vmap_app_store
	current? \
	title? \
	current_exists false
	sub /
		<= Head $mol_view
			sub /
				\Сцены
		<= List $mol_list
			rows <= scene_rows /
		<= Title $mol_string
			hint \Название сцены
			enabled <= current_exists
			value? <=> title?
		<= Add $mol_button_minor
			title \Новая сцена
			hint \Завести новый документ. Он станет текущим
			click? <=> add? null
	Scene_row* $bog_vmap_app_palette_item
		title <= scene_title* \
		hint <= scene_title* \
		current <= scene_current* false
		click? <=> scene_click*? null

$mol_icon_upload $mol_icon path \M9,16V10H5L12,3L19,10H15V16H9M5,20V18H19V20H5Z

$mol_button_open $mol_button_minor
	sub /
		<= Icon $mol_icon_upload
		<= Native $mol_button_open_native
			files? <=> files_handled? <=> files? /File
			accept <= accept \
			multiple <= multiple true

$mol_button_open_native $mol_view
	dom_name \input
	files? /File
	attr *
		type \file
		accept <= accept \
		multiple <= multiple true
	event *
		change? <=> picked? null

$bog_vmap_app_shelf $mol_view
	links? \
	pack_link \
	land_classes /$mol_tree2
	class_list /string
	dragged? \
	drag_x? 0
	drag_y? 0
	drag_source \
	drag_title \
	item_source* \
	place? \
	files? /File
	classes_showed? false
	sub <= body /$mol_view
	Title $mol_view
		sub /
			\Полка
	Stack $mol_scroll
		sub /
			<= Stack_body $mol_view
				sub <= stack_content /$mol_view
	Items $mol_list
		rows <= item_rows /
	Source $mol_view
		sub <= source_content /$mol_view
	Packs $mol_view
		sub /
			<= Packs_title $mol_view
				sub /
					\Пак компонентов
			<= Pack_list $mol_list
				rows <= pack_rows /
	Pack_row* $mol_button_minor
		title <= pack_title* \
		hint <= pack_hint* \
		attr *
			^
			bog_vmap_app_shelf_pack_current <= pack_current* false
		click? <=> pack_click*? null
	Links $mol_string
		hint \Адрес приложения, ленды через запятую
		value? <=> links?
	Import $mol_view
		sub /
			<= Import_open $mol_button_open
				hint \Файлы .view.tree модуля mol. Объявления приедут, поведение — нет
				accept \.tree
				multiple true
				files? <=> files?
			<= Import_title $mol_view
				sub /
					\Файлы модуля
	Import_note $mol_view
		sub / <= import_note? \
	Store $bog_vmap_app_publish_store
	Note $mol_view
		sub / <= rejected_note \
	Apps $mol_view
		sub <= apps_content /$mol_view
	Apps_head $mol_view
		sub /
			<= apps_title \
	App_list $mol_list
		rows <= app_rows /
	Apps_note $mol_view
		sub / <= app_error \
	Level $mol_check
		title \Все классы пака
		hint \Классы донорского пака целиком: примитивы, из которых верстают внутри блока
		checked? <=> classes_showed?
	Palette $bog_vmap_app_palette
		compact true
		pack_link <= pack_link
		land_classes <= land_classes
		dragged? <=> dragged?
		drag_x? <=> drag_x?
		drag_y? <=> drag_y?
	Item_row* $bog_vmap_app_palette_item
		title <= item_title* \
		hint <= item_hint* \
		click? <=> item_click*? null
		drag_start? <=> item_drag*? null

$bog_vmap_app_inspect_flex $mol_view
	value*? \
	sub /
		<= Width $bog_vmap_app_inspect_flex_row
			title \Ширина
			Field <= Width_pick $mol_switch
				value? <=> width? \
				options *
					390px \мобильная
					768px \планшет
					1280px \десктоп
		<= Direction $bog_vmap_app_inspect_flex_row
			title \Направление
			Field <= Direction_pick $mol_switch
				value? <=> direction? \
				options *
					column \колонкой
					row \рядом
		<= Across $bog_vmap_app_inspect_flex_row
			title \Поперёк
			Field <= Across_pick $mol_switch
				value? <=> across? \
				options *
					flex-start \к началу
					center \по центру
					flex-end \к концу
					stretch \во всю
		<= Along $bog_vmap_app_inspect_flex_row
			title \Вдоль
			Field <= Along_pick $mol_switch
				value? <=> along? \
				options *
					flex-start \к началу
					center \по центру
					flex-end \к концу
					space-between \по краям
		<= Gap $bog_vmap_app_inspect_flex_row
			title \Зазор
			Field <= Gap_field $mol_string
				hint \1rem
				value? <=> gap? \
		<= Grow $bog_vmap_app_inspect_flex_row
			title \Растяжение
			Field <= Grow_check $mol_check
				title \занимать свободное место
				checked? <=> grow? false

$bog_vmap_app_inspect_flex_row $mol_view
	title \
	Field $mol_view
	sub /
		<= Title $mol_view sub / <= title
		<= Field

$mol_ghost $mol_view
	Sub $mol_view

$mol_follower $mol_ghost
	Anchor $mol_view
	align /number
		-.5
		-.5
	offset /number
		0
		0
	style *
		^
		transform <= transform \

$mol_pop $mol_view
	showed? false
	align_vert \
	align_hor \
