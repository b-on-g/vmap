$bog_vmap_app_pane $mol_view
	attr *
		^
		tabindex \-1
	leave? null
	scene_bundle \
	scene_html \
	pack_uri \
	theme \
	doc_src \
	doc_css \
	spots? *
	picked? /string
	doc_js *
	doc_root \
	libs /$bog_vmap_bridge_part
	carrying false
	wires /$bog_vmap_lang_link
	part_ports* /$bog_vmap_app_wire_port
	part_overs* /string
	link_add? null
	link_drop? null
	containers /string
	doc_names /string
	axis* \
	tree_move? null
	carry_at? null
	carry_drop? null
	files_drop? null
	file_over? null
	file_take? null
	event *
		^
		dragover? <=> file_over? null
		drop? <=> file_take? null
	values? *
	handshake*? 0
	ready false
	stalled? false
	warmed? false
	entered? null
	inside false
	world_center /number
	free_spot /number
	camera_fit? null
	node_error* \
	scene_restart? null
	error_at*? \
	error_node*? \
	pack_note \
	error \
	isolation \
	camera_shift? $mol_vector_2d<number> /
		0
		0
	camera_zoom? 1
	scene_generation? 0
	Scene* $bog_vmap_app_pane_frame
		html <= scene_html
	sub /
		<= Overlay $bog_vmap_app_pane_overlay
			style <= overlay_style *
			frames <= frames /string
			frame_style* <= frame_style* *
			press? <=> node_press? null
			move? <=> node_move? null
			release? <=> node_release? null
		<= Wire $bog_vmap_app_wire
			lines <= wire_lines /$bog_vmap_app_wire_line
			dots <= wire_dots /$bog_vmap_app_wire_dot
			drag_geometry <= wire_drag_geometry \
		<= Values $mol_view
			sub <= value_labels /$mol_view
		<= Marks $mol_view
			sub <= error_marks /$mol_view
		<= Camera $mol_view
			sub /
				<= Zoom_out $mol_button_minor
					title \−
					hint \Отдалить
					click? <=> zoom_out? null
				<= Zoom_title $mol_view
					sub /
						<= zoom_title \
				<= Zoom_in $mol_button_minor
					title \+
					hint \Приблизить
					click? <=> zoom_in? null
				<= Reset $mol_button_minor
					title \Сбросить вид
					click? <=> camera_reset? null
	Label* $bog_vmap_app_pane_label
		style <= label_style* *
		lines <= label_lines* /string
	Mark* $mol_view
		style <= mark_style* *
		attr *
			^
			title <= mark_hint* \
		sub /
			\!
	Insert $mol_view
		style <= insert_style *
	Band $mol_view
		style <= band_style *
	plugins /
		^
		<= Touch $mol_touch
			allow_draw false
			allow_pan true
			allow_zoom true
			pan? <=> camera_shift?
			zoom? <=> camera_zoom?

$bog_vmap_app_pane_overlay $mol_view
	frames /string
	frame_style* *
	press? null
	move? null
	release? null
	event *
		^
		pointerdown? <=> press? null
		pointermove? <=> move? null
		pointerup? <=> release? null
	Frame* $mol_view
		style <= frame_style* *
		sub /
			<= Handle_nw $bog_vmap_app_pane_handle corner \nw
			<= Handle_ne $bog_vmap_app_pane_handle corner \ne
			<= Handle_sw $bog_vmap_app_pane_handle corner \sw
			<= Handle_se $bog_vmap_app_pane_handle corner \se

$bog_vmap_app_pane_label $mol_view
	lines /string
	sub <= rows /$mol_view
	Row* $mol_view
		sub <= row_cells* /$mol_view
	Cell* $mol_view
		sub /
			<= cell_text* \

$bog_vmap_app_pane_handle $mol_view
	corner \
	attr *
		^
		bog_vmap_app_pane_handle_corner <= corner

$bog_vmap_app_pane_frame $mol_frame
	attr *
		sandbox \allow-scripts
		^
		src null
