$bog_vmap_app_pane $mol_view
	attr *
		^
		tabindex \-1
		bog_vmap_app_pane_tool <= tool
		bog_vmap_app_pane_hand <= hand
	tool? \select
	grip? false
	hand false
	tool_select? false
	tool_board? false
	tool_hand? false
	editable true
	board_draw? null
	node_delete? null
	node_copy? null
	node_wrap? null
	node_clone? null
	leave? null
	key_down* false
	key_up* null
	scene_bundle \
	scene_html \
	pack_uri \
	theme \
	doc_src \
	doc_css \
	spots? *
	picked? /string
	inner \
	doc_js *
	doc_root \
	libs /$bog_vmap_bridge_part
	carrying false
	wires /$bog_vmap_lang_link
	part_ports* /$bog_vmap_app_wire_port
	part_overs* /string
	link_add? null
	link_drop? null
	containers /string
	doc_names /string
	doc_paths /string
	doc_key \
	node_title? \
	axis* \
	tree_move? null
	carry_at? null
	carry_drop? null
	files_drop? null
	file_over? null
	file_take? null
	event *
		^
		dragover? <=> file_over? null
		drop? <=> file_take? null
	values? *
	handshake*? 0
	ready false
	stalled? false
	warmed? false
	entered? null
	inside false
	world_center /number
	free_spot /number
	key_field* false
	part_size* null
	copy_spot* null
	camera_fit? null
	camera_reset? null
	node_show? null
	zoom_out? null
	zoom_in? null
	zoom_title \
	node_error* \
	scene_restart? null
	error_at*? \
	error_node*? \
	pack_note \
	error \
	isolation \
	camera_shift? $mol_vector_2d<number> /
		0
		0
	camera_zoom? 1
	scene_generation? 0
	Scene* $bog_vmap_app_pane_frame
		html <= scene_html
	sub /
		<= Overlay $bog_vmap_app_pane_overlay
			style <= overlay_style *
			frames <= frames /string
			frame_style* <= frame_style* *
			inner <= inner_shown \
			inner_style <= inner_style *
			press? <=> node_press? null
			move? <=> node_move? null
			release? <=> node_release? null
			away? <=> node_away? null
			context? <=> node_context? null
		<= Wire $bog_vmap_app_wire
			lines <= wire_lines /$bog_vmap_app_wire_line
			dots <= wire_dots /$bog_vmap_app_wire_dot
			drag_geometry <= wire_drag_geometry \
		<= Values $mol_view
			sub <= value_labels /$mol_view
		<= Names $mol_view
			sub <= name_views /$mol_view
		<= Marks $mol_view
			sub <= error_marks /$mol_view
	Label* $bog_vmap_app_pane_label
		style <= label_style* *
		lines <= label_lines* /string
	Name* $mol_view
		style <= name_style* *
		attr *
			^
			bog_vmap_app_pane_name_picked <= name_picked* false
		event *
			^
			click? <=> name_press*? null
			dblclick? <=> name_edit*? null
		sub /
			<= name_title* \
	Name_field* $mol_string
		style <= name_style* *
		hint \имя узла
		value? <=> name_draft*? \
		submit? <=> name_submit*? null
		event *
			^
			blur? <=> name_submit*? null
			keydown? <=> name_key*? null
	Mark* $mol_view
		style <= mark_style* *
		attr *
			^
			title <= mark_hint* \
		sub /
			\!
	Insert $mol_view
		style <= insert_style *
	Band $mol_view
		style <= band_style *
	Draft $mol_view
		style <= draft_style *
	Guide* $mol_view
		style <= guide_style* *
	Menu* $bog_vmap_app_menu
		showed? <=> menu_showed? false
		left <= menu_left \
		top <= menu_top \
		on_node <= menu_on_node false
		editable <= editable
		copy? <=> node_copy?
		remove? <=> node_delete?
		wrap? <=> node_wrap?
		parent? <=> menu_parent? null
		parent_enabled <= menu_parent_enabled false
		enter? <=> menu_enter? null
		board? <=> menu_board? null
		fit? <=> camera_reset?
	plugins /
		^
		<= Touch $mol_touch
			allow_draw false
			allow_pan true
			allow_zoom true
			pan? <=> camera_shift?
			zoom? <=> camera_zoom?

$bog_vmap_app_pane_overlay $mol_view
	frames /string
	frame_style* *
	inner \
	inner_style *
	press? null
	move? null
	release? null
	away? null
	context? null
	event *
		^
		pointerdown? <=> press? null
		pointermove? <=> move? null
		pointerup? <=> release? null
		pointerleave? <=> away? null
		contextmenu? <=> context? null
	Frame* $mol_view
		style <= frame_style* *
		sub /
			<= Handle_nw $bog_vmap_app_pane_handle corner \nw
			<= Handle_ne $bog_vmap_app_pane_handle corner \ne
			<= Handle_sw $bog_vmap_app_pane_handle corner \sw
			<= Handle_se $bog_vmap_app_pane_handle corner \se
	Inner $mol_view
		style <= inner_style *

$bog_vmap_app_pane_label $mol_view
	lines /string
	sub <= rows /$mol_view
	Row* $mol_view
		sub <= row_cells* /$mol_view
	Cell* $mol_view
		sub /
			<= cell_text* \

$bog_vmap_app_pane_handle $mol_view
	corner \
	attr *
		^
		bog_vmap_app_pane_handle_corner <= corner

$bog_vmap_app_pane_frame $mol_frame
	attr *
		sandbox \allow-scripts
		^
		src null
