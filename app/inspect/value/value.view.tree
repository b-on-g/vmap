$bog_vmap_app_inspect_value $mol_view
	tree? $mol_tree2_empty
	binds /string
	nodes *
	alarm? \
	sub <= editors /$mol_view
	Alarm $mol_view sub / <= alarm
	String $bog_vmap_app_inspect_value_string
		tree? <=> tree?
	Number $bog_vmap_app_inspect_value_number
		tree? <=> tree?
		alarm? <=> alarm?
	Bool $bog_vmap_app_inspect_value_bool
		tree? <=> tree?
	Seq $bog_vmap_app_inspect_value_seq
		tree? <=> tree?
		keyed <= seq_keyed false
		klass <= seq_klass false
		binds <= binds
		nodes <= nodes
		alarm? <=> alarm?
	Bind $bog_vmap_app_inspect_value_bind
		tree? <=> tree?
		binds <= binds
		nodes <= nodes
		alarm? <=> alarm?
	Wire $bog_vmap_app_inspect_value_wire
		tree? <=> tree?
		nodes <= nodes
		alarm? <=> alarm?
	Raw $bog_vmap_app_inspect_value_raw
		tree? <=> tree?

$bog_vmap_app_inspect_value_area $mol_string
	dom_name \textarea
	attr *
		^
		rows <= rows 1
	plugins /

$bog_vmap_app_inspect_value_string $mol_view
	tree? $mol_tree2_empty
	sub /
		<= Text $bog_vmap_app_inspect_value_area
			hint \текст
			rows <= text_rows 1
			value? <=> text? \
		<= Locale $mol_check
			title \@
			hint \Многоязычное: текст уедет в таблицу локалей
			checked? <=> locale? false

$bog_vmap_app_inspect_value_number $mol_view
	tree? $mol_tree2_empty
	alarm? \
	sub /
		<= Num $mol_string
			hint \число
			value? <=> num? \

$bog_vmap_app_inspect_value_bool $mol_view
	tree? $mol_tree2_empty
	sub /
		<= Flag $mol_check
			title <= flag_title \
			checked? <=> flag? false

$bog_vmap_app_inspect_value_raw $mol_view
	tree? $mol_tree2_empty
	sub / <= raw \

$bog_vmap_app_inspect_value_seq $mol_view
	tree? $mol_tree2_empty
	binds /string
	nodes *
	alarm? \
	keyed false
	klass false
	sub <= seq_sub /$mol_view
	Class_name $mol_string
		hint \класс
		value? <=> class_name? \
	Items $mol_view
		sub <= items /
	Add $mol_button_minor
		title <= add_title \
		hint \Добавить
		click? <=> item_add? null
	Item* $bog_vmap_app_inspect_value_item
		keyed <= keyed
		marker <= item_marker* false
		key? <=> item_key*? \
		value? <=> item_value*? $mol_tree2_empty
		binds <= binds
		nodes <= nodes
		drop? <=> item_drop*? null

$bog_vmap_app_inspect_value_item $mol_view
	value? $mol_tree2_empty
	binds /string
	nodes *
	keyed false
	marker false
	drop? null
	sub <= item_sub /$mol_view
	Key $mol_string
		hint \ключ
		value? <=> key? \
	Value $bog_vmap_app_inspect_value
		tree? <=> value?
		binds <= binds
		nodes <= nodes
	Drop $mol_button_minor
		title \✕
		hint \Убрать
		click? <=> drop?

$bog_vmap_app_inspect_value_bind $mol_view
	tree? $mol_tree2_empty
	binds /string
	nodes *
	alarm? \
	sub <= bind_sub /$mol_view
	Op $mol_view sub / <= op \
	Target $mol_select
		hint \свойство
		value? <=> target? \
		options <= binds
	Default $bog_vmap_app_inspect_value
		tree? <=> default_value? $mol_tree2_empty
		binds <= binds
		nodes <= nodes

$bog_vmap_app_inspect_value_wire $mol_view
	tree? $mol_tree2_empty
	nodes *
	alarm? \
	sub <= wire_sub /$mol_view
	Row $mol_view
		sub <= wire_row /$mol_view
	Op $mol_view sub / \=
	Origin $mol_select
		hint \узел
		value? <=> origin? \
		options <= node_names /string
	Dot $mol_view sub / \.
	Port_pick $mol_select
		hint \порт
		value? <=> port? \
		options <= ports /string
	Port_free $mol_string
		hint \порт
		value? <=> port? \
	Note $mol_view sub / <= note \
