$bog_vmap_app_inspect $mol_page
	source? \
	peers /$mol_tree2
	pack? \https://mol.hyoo.ru
	class_title? \
	title_note \
	title <= class_title
	title_content /
		<= Name $mol_string
			hint \имя узла
			value? <=> title_value? \
			submit? <=> title_submit? null
			event *
				^
				blur? <=> title_submit? null
	tools /$mol_view_content
		<= base_title \
		<= total \
		<= Note $mol_status
			status <= title_note
	body /$mol_view
		<= Flex $bog_vmap_app_inspect_flex
			value*? <=> flex_value*? \
		<= Rows $mol_list
			rows <= rows /$mol_view
		<= Inherited $mol_expander
			title \Наследованные
			expanded? <=> inherited_shown? true
			content <= inherited_rows /$mol_view
	Empty $mol_status
		status <= empty_note \Нечего править: в исходнике нет объявления класса
	Node $bog_vmap_lang_node
		source? <=> source?
	Lib $bog_vmap_lib
		pack <= pack
		classes <= classes /
	Row* $bog_vmap_app_inspect_row
		sign <= row_sign* \
		owner <= row_owner* \
		inherited <= row_inherited* false
		value? <=> row_value*? $mol_tree2_empty
		keyed? <=> row_keyed*? false
		changeable? <=> row_changeable*? false
		drop? <=> row_drop*? null
		binds <= binds /string
		nodes <= nodes *

$bog_vmap_app_inspect_demo $mol_book2
	source? \
	pages /
		<= Source $mol_page
			title \Исходник документа
			tools /
				<= Class_pick $mol_select
					hint \класс
					value? <=> klass? \
					options <= names /string
			body /
				<= Source_text $bog_vmap_app_inspect_value_area
					rows 26
					value? <=> source?
		<= Inspect $bog_vmap_app_inspect
			source? <=> class_source? \
			peers <= trees /$mol_tree2
	Doc $bog_vmap_lang_doc
		source? <=> source?
