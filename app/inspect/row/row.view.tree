$bog_vmap_app_inspect_row $mol_view
	sign \
	owner \
	inherited false
	value? $mol_tree2_empty
	binds /string
	nodes *
	keyed? false
	changeable? false
	drop? null
	sub /
		<= Head $mol_view
			sub /
				<= Sign $mol_view sub / <= sign
				<= Owner $mol_view sub / <= owner
				<= Tools $mol_view sub <= tools /
		<= Value $bog_vmap_app_inspect_value
			tree? <=> value?
			binds <= binds
			nodes <= nodes
	Key $mol_check
		title \*
		hint \Много значений по ключу
		checked? <=> keyed?
	Next $mol_check
		title \?
		hint \Изменяемое
		checked? <=> changeable?
	Drop $mol_button_minor
		title \✕
		hint \Убрать свойство из документа
		click? <=> drop?
	attr *
		^
		bog_vmap_app_inspect_row_inherited <= inherited
