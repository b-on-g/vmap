$bog_vmap_app_inspect_row $mol_form_field
	sign \
	owner \
	inherited false
	value? $mol_tree2_empty
	binds /string
	nodes *
	keyed? false
	changeable? false
	drop? null
	editable true
	frozen \
	note \
	name <= sign
	bid <= owner
	label /
		^
		<= Tools $mol_row
			sub <= tools /$mol_view
	control <= Value $bog_vmap_app_inspect_value
		tree? <=> value?
		binds <= binds
		nodes <= nodes
		note <= note
		editable <= editable
	Frozen $mol_status
		status <= frozen
	Key $mol_check
		title \*
		hint \Много значений по ключу
		checked? <=> keyed?
		enabled <= editable
	Next $mol_check
		title \?
		hint \Изменяемое
		checked? <=> changeable?
		enabled <= editable
	drop_hint \Убрать свойство из документа
	Drop $mol_button_minor
		title \✕
		hint <= drop_hint
		click? <=> drop?
		enabled <= editable
