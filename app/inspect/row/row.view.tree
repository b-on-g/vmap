$bog_vmap_app_inspect_row $mol_form_field
	sign \
	owner \
	inherited false
	value? $mol_tree2_empty
	binds /string
	nodes *
	keyed? false
	changeable? false
	drop? null
	name <= sign
	bid <= owner
	label /
		^
		<= Tools $mol_row
			sub <= tools /$mol_view
	control <= Value $bog_vmap_app_inspect_value
		tree? <=> value?
		binds <= binds
		nodes <= nodes
	Key $mol_check
		title \*
		hint \Много значений по ключу
		checked? <=> keyed?
	Next $mol_check
		title \?
		hint \Изменяемое
		checked? <=> changeable?
	Drop $mol_button_minor
		title \✕
		hint \Убрать свойство из документа
		click? <=> drop?
