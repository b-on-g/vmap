$bog_vmap_app_scenes $mol_view
	store $bog_vmap_app_store
	current? \
	title? \
	current_exists false
	sub /
		<= Head $mol_view
			sub /
				\Сцены
		<= List $mol_list
			rows <= scene_rows /
		<= Title $mol_string
			hint \Название сцены
			enabled <= current_exists
			value? <=> title?
		<= Add $mol_button_minor
			title \Новая сцена
			hint \Завести новый документ. Он станет текущим
			click? <=> add? null
	Scene_row* $bog_vmap_app_palette_item
		title <= scene_title* \
		hint <= scene_title* \
		current <= scene_current* false
		click? <=> scene_click*? null
