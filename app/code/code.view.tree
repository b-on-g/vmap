$bog_vmap_app_code $mol_view
	klass \
	prop \
	hooks /string
	source? \
	node_source? \
	js? \
	css? \
	error \
	whole? false
	refusal? \
	event *
		^
		focusout? <=> field_leave? null
	sub <= content /$mol_view
	Head $mol_bar
		sub <= head_content /$mol_view
	Scope_note $mol_view
		sub / <= scope_note \
	Scope $mol_check
		title \Весь класс
		hint \Править класс целиком, а не выбранный узел. Какой это класс, сказано в шапке: у узла со своим классом — его, у остальных — тот, который узел объявляет
		checked? <=> whole?
	Alarm $mol_view
		sub / <= error
	Refusal $mol_view
		sub / <= note \
	Typing $mol_view
		sub <= typing_rows /$mol_view
	Typing_row* $mol_view
		sub / <= typing_text* \
	Sources $bog_vmap_app_code_deck
		items <= source_tabs /$mol_view
	Tree $mol_textarea
		title \view.tree
		hint \Имя_узла $mol_view
		sidebar_showed true
		value? <=> tree_text? \
		event *
			^
			pointerdown? <=> tree_press? null
	Js $mol_textarea
		title \JS
		hint \
		sidebar_showed true
		value? <=> js_text? \
		event *
			^
			pointerdown? <=> js_press? null
	Js_idle $mol_view
		title \JS
		sub / <= js_idle_note \
	Css $mol_textarea
		title \CSS
		hint \
		sidebar_showed true
		value? <=> css_text? \
		event *
			^
			pointerdown? <=> css_press? null

$bog_vmap_app_code_deck $mol_deck
