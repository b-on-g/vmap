$bog_vmap_spike_s1 $mol_view
	plugins /
		<= Theme $mol_theme_auto
	sub /
		<= Editors $mol_scroll
			sub /
				<= Editors_list $mol_list
					rows /
						<= Head $mol_paragraph
							title \S1 · runtime build of a $mol component from three sources
						<= Status $mol_paragraph
							title <= status \
						<= Tree_field $mol_form_field
							name \view.tree
							control <= Source_tree $mol_textarea
								hint \Component declaration, view.tree syntax
								value? <=> source_tree? \
						<= Js_field $mol_form_field
							name \behavior · class body
							control <= Source_js $mol_textarea
								hint \Class body: methods only, no braces around them
								value? <=> source_js? \
						<= Css_field $mol_form_field
							name \styles
							control <= Source_css $mol_textarea
								hint \CSS attached to the compiled class
								value? <=> source_css? \
		<= Stage $mol_scroll
			sub /
				<= Stage_body $mol_view
					sub <= stage /$mol_view
