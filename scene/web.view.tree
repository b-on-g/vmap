	plugins /
		^
		<= Touch $mol_touch
			zoom? <=> zoom? 1
			pan? <=> shift?
			pointer_center => cursor_position
			allow_draw <= allow_draw true
			allow_pan <= allow_pan true
			allow_zoom <= allow_zoom true
			action_type => action_type
			action_point => action_point
			draw_start? <=> draw_start? null
			draw? <=> draw? null
			draw_end? <=> draw_end? null
	- event *
		^
		dblclick? <=> reset? null

- The sandbox application. Runs untrusted code, talks to the host only by
- postMessage. Knows nothing about Giper Baza, the network or user keys.
- @see ../ARCHITECTURE.md section 4

$bog_vmap_scene $mol_view
	sub /
		- The canvas ground. Inside the frame since the frame stopped being see
		- through: a `color-scheme` is what gives a frame its base colour, and
		- without one Chrome keeps the frame transparent only until the transform
		- on `Stage` promotes it to its own layer, then washes it pale. Declaring
		- the scheme fixes the tone and makes the frame opaque, so anything that
		- has to be under the document has to be in here with it.
		-
		- Still not transformed, and that is the point of section 8: the camera
		- moves the lines by recomputing the `d` of the path, so a stroke stays one
		- pixel at any zoom. Exactly one CSS transform in the system, and it is on
		- `Stage`, not here.
		<= Grid $bog_vmap_scene_grid
			shift <= grid_shift $mol_vector_2d<number> /
				0
				0
			scale <= grid_scale $mol_vector_2d<number> /
				1
				1
		<= Stage $mol_view
			style *
				transform <= camera_transform \none
			sub <= stage /$mol_view_content
	-
	- Stated wait instead of an empty canvas: a cold pack is 2.25 MB and 610 ms,
	- and a blank frame for that long reads as a breakage.
	Wait $mol_view
		sub /
			<= pack_note \

$mol_icon_close $mol_icon path \M19,6.41L17.59,5L12,10.59L6.41,5L5,6.41L10.59,12L5,17.59L6.41,19L12,13.41L17.59,19L19,17.59L13.41,12L19,6.41Z

$mol_hotkey $mol_plugin
	event *
		^
		keydown? <=> keydown? null
	key *
	mod_ctrl false
	mod_alt false
	mod_shift false

$mol_string $mol_view
	dom_name \input
	enabled true
	minimal_height 40
	autocomplete false
	selection? /number
		0
		0
	auto /
		<= selection_watcher null
		<= error_report null
	field *
		^
		disabled <= disabled false
		value <= value_changed? <=> value? \
		placeholder <= hint_visible <= hint \
		spellcheck <= spellcheck true
		autocomplete <= autocomplete_native \
		selectionEnd <= selection_end 0
		selectionStart <= selection_start 0
		inputMode <= keyboard \text
		enterkeyhint <= enter \go
	attr *
		^
		maxlength <= length_max +Infinity
		type <= type? \text
	event *
		^
		input? <=> event_change? null
	plugins /
		<= Submit $mol_hotkey
			mod_ctrl <= submit_with_ctrl false
			key * enter? <=> submit? null
