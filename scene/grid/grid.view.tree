- Background grid in world coordinates. Line placement comes from the ruler of the
- plotting module; its pane is not taken: it auto fits to data and renders svg-only
- graphs.
$bog_vmap_scene_grid $mol_svg_root
	aspect \none
	shift $mol_vector_2d<number> /
		0
		0
	scale $mol_vector_2d<number> /
		1
		1
	sub <= rulers /$mol_svg
	Ruler_hor $bog_vmap_scene_grid_hor
		title \
	Ruler_vert $bog_vmap_scene_grid_vert
		title \

$bog_vmap_scene_grid_hor $mol_plot_ruler_hor
	title \

$bog_vmap_scene_grid_vert $mol_plot_ruler_vert
	title \
